#!/bin/sh /etc/rc.common
# Re-apply the sysfs HDD tuning at boot: the scheduler and read-ahead values
# reset with every kernel boot, and this firmware has no udev rule to restore
# them.  The tool itself lives on the internal disk; when that disk is absent
# the hook simply does nothing.
START=99
STOP=01

start() {
	tool=/userdisk/data/.yunshu/live/tools/hdd-tune.sh
	[ -x "$tool" ] || return 0
	"$tool" apply >/dev/null 2>&1

	# The USB disk can finish probing after S99; wait up to 10 s for it so its
	# scheduler is set at boot instead of on the first hotplug event.
	i=0
	while [ "$i" -lt 10 ] && [ ! -d /sys/block/sdb/queue ]; do
		sleep 1
		i=$((i + 1))
	done
	"$tool" apply >/dev/null 2>&1
	return 0
}
