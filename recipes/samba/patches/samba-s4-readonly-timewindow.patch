+static NTSTATUS readonly_create_file(struct vfs_handle_struct *handle,
+				     struct smb_request *req,
+				     struct files_struct *dirfsp,
+				     struct smb_filename *smb_fname,
+				     uint32_t access_mask,
+				     uint32_t share_access,
+				     uint32_t create_disposition,
+				     uint32_t create_options,
+				     uint32_t file_attributes,
+				     uint32_t oplock_request,
+				     const struct smb2_lease *lease,
+				     uint64_t allocation_size,
+				     uint32_t private_flags,
+				     struct security_descriptor *sd,
+				     struct ea_list *ea_list,
+				     files_struct **result,
+				     int *pinfo,
+				     const struct smb2_create_blobs *in_context_blobs,
+				     struct smb2_create_blobs *out_context_blobs)
+{
+	const char *period_def[] = {"today 0:0:0", "tomorrow 0:0:0"};
+	const char **period;
+	time_t current_time;
+	time_t begin_period;
+	time_t end_period;
+	int snum;
+
+	snum = (handle->conn != NULL) ? SNUM(handle->conn) : -1;
+	period = lp_parm_string_list(snum,
+				     (handle->param ? handle->param : MODULE_NAME),
+				     "period", period_def);
+	if (period == NULL || period[0] == NULL || period[1] == NULL) {
+		goto next;
+	}
+	if (handle->conn == NULL || handle->conn->read_only) {
+		goto next;
+	}
+
+	current_time = readonly_current_time();
+	begin_period = get_date(period[0], &current_time);
+	end_period = get_date(period[1], &current_time);
+
+	if ((current_time >= begin_period) && (current_time <= end_period)) {
+		DEBUG(1, ("check_if_time_in_range: [true] start: %d, end: %d, "
+			  "current: %d\n",
+			  (int)begin_period, (int)end_period,
+			  (int)current_time));
+		DEBUG(1, ("create file failed caused by readonly timerange "
+			  "limit.\n"));
+		return NT_STATUS_ACCESS_DENIED;
+	}
+
+	DEBUG(1, ("check_if_time_in_range: [false] start: %d, end: %d, "
+		  "current: %d\n",
+		  (int)begin_period, (int)end_period, (int)current_time));
+
+next:
+	return SMB_VFS_NEXT_CREATE_FILE(handle, req, dirfsp, smb_fname,
+					access_mask, share_access,
+					create_disposition, create_options,
+					file_attributes, oplock_request,
+					lease, allocation_size,
+					private_flags, sd, ea_list, result,
+					pinfo, in_context_blobs,
+					out_context_blobs);
+}
 
