+/*
+   Xiaomi MAC based share policy, Samba 4.25.x port.
+
+   Reconstructed from the vendor samba_multicall 4.0.21 binary
+   (docs/baseline/mac-policy.md).  The decision itself is:
+
+     listed   (MAC in /tmp/loginMac.cfg or nonLoginMac.cfg)
+              -> allowed on non-browseable shares only
+     unlisted (including "MAC could not be resolved")
+              -> allowed on browseable shares only
+
+   MAC resolution mirrors the vendor chain:
+     ip_mac cache -> ubus trafficd -> /proc/net/arp -> arping -> cache
+
+   Configuration is read from the environment so that the smb.conf /
+   loadparm schema stays compatible with the stock 4.0.21 config:
+
+     XIAOMI_MAC_FILTER=0|1            default 1
+     XIAOMI_LOGIN_MAC_FILE            default /tmp/loginMac.cfg
+     XIAOMI_NONLOGIN_MAC_FILE         default /userdisk/datacenterConfig/nonLoginMac.cfg
+     XIAOMI_ARP_FILE                  default /proc/net/arp
+     XIAOMI_ARP_INTERFACE             default br-lan
+     XIAOMI_TRAFFICD_CMD              default "ubus call trafficd ip | /usr/sbin/jason.sh -b"
+     XIAOMI_MAC_CACHE_TTL             seconds, default 60, 0 disables the cache
+
+   This program is free software; you can redistribute it and/or modify
+   it under the terms of the GNU General Public License as published by
+   the Free Software Foundation; either version 3 of the License, or
+   (at your option) any later version.
+*/
+
+#include "includes.h"
+#include "system/filesys.h"
+#include "smbd/smbd.h"
+#include "smbd/xiaomi_mac_policy.h"
+#include "../lib/tsocket/tsocket.h"
+
+#define XIAOMI_DEFAULT_LOGIN_MAC_FILE "/tmp/loginMac.cfg"
+#define XIAOMI_DEFAULT_NONLOGIN_MAC_FILE \
+	"/userdisk/datacenterConfig/nonLoginMac.cfg"
+#define XIAOMI_DEFAULT_ARP_FILE "/proc/net/arp"
+#define XIAOMI_DEFAULT_ARP_INTERFACE "br-lan"
+#define XIAOMI_DEFAULT_TRAFFICD_CMD \
+	"ubus call trafficd ip | /usr/sbin/jason.sh -b"
+
+#define XIAOMI_MAC_CACHE_SIZE 64
+
+struct xiaomi_mac_cache_entry {
+	char ip[INET_ADDRSTRLEN];
+	char mac[18];
+	time_t timestamp;
+};
+
+static struct xiaomi_mac_cache_entry xiaomi_mac_cache[XIAOMI_MAC_CACHE_SIZE];
+static pthread_mutex_t xiaomi_mac_cache_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static bool xiaomi_helper_disabled(const char *value)
+{
+	return strequal(value, "none") ||
+	       strequal(value, "-") ||
+	       strequal(value, "disabled");
+}
+
+static const char *xiaomi_env(const char *name, const char *def)
+{
+	const char *value = getenv(name);
+
+	if (value == NULL || value[0] == '\0') {
+		return def;
+	}
+	return value;
+}
+
+bool xiaomi_mac_filter_enabled(void)
+{
+	const char *value = xiaomi_env("XIAOMI_MAC_FILTER", "1");
+
+	if (strequal(value, "0") ||
+	    strcasecmp_m(value, "no") == 0 ||
+	    strcasecmp_m(value, "false") == 0 ||
+	    strcasecmp_m(value, "off") == 0) {
+		return false;
+	}
+	return true;
+}
+
+static int xiaomi_cache_ttl(void)
+{
+	const char *value = xiaomi_env("XIAOMI_MAC_CACHE_TTL", "60");
+	int ttl = atoi(value);
+
+	if (ttl < 0) {
+		ttl = 0;
+	}
+	return ttl;
+}
+
+static bool xiaomi_mac_is_valid(const char *mac)
+{
+	size_t i;
+
+	if (mac == NULL || strlen(mac) != 17) {
+		return false;
+	}
+	for (i = 0; i < 17; i++) {
+		if ((i % 3) == 2) {
+			if (mac[i] != ':') {
+				return false;
+			}
+		} else if (!isxdigit((unsigned char)mac[i])) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static void xiaomi_mac_lower(char *mac)
+{
+	size_t i;
+
+	for (i = 0; mac[i] != '\0'; i++) {
+		mac[i] = (char)tolower((unsigned char)mac[i]);
+	}
+}
+
+/*
+ * Normalize the peer address to a plain IPv4 string.  IPv4 mapped IPv6
+ * addresses (::ffff:192.168.3.5) are accepted, everything else is
+ * treated as "no usable address" and therefore as unlisted.
+ */
+static bool xiaomi_ipv4_string(const char *remote, char out[INET_ADDRSTRLEN])
+{
+	struct in_addr addr;
+
+	if (remote == NULL) {
+		return false;
+	}
+	if (strncasecmp_m(remote, "::ffff:", 7) == 0) {
+		remote += 7;
+	}
+	if (inet_pton(AF_INET, remote, &addr) != 1) {
+		return false;
+	}
+	strlcpy(out, remote, INET_ADDRSTRLEN);
+	return true;
+}
+
+static bool xiaomi_mac_from_trafficd(const char *ip, char mac[18])
+{
+	char cmd[512];
+	char line[256];
+	char key[64];
+	char hw[32];
+	FILE *p;
+	bool found = false;
+	const char *trafficd = xiaomi_env("XIAOMI_TRAFFICD_CMD",
+					  XIAOMI_DEFAULT_TRAFFICD_CMD);
+
+	if (xiaomi_helper_disabled(trafficd)) {
+		return false;
+	}
+	snprintf(cmd, sizeof(cmd),
+		 "PATH=/usr/sbin:/usr/bin:/sbin:/bin %s", trafficd);
+	p = popen(cmd, "r");
+	if (p == NULL) {
+		return false;
+	}
+	while (fgets(line, sizeof(line), p) != NULL) {
+		if (sscanf(line, "[\"%63[^\"]\",\"hw\"]\t\"%31[^\"]\"",
+			   key, hw) != 2) {
+			continue;
+		}
+		if (!strequal(key, ip) || !xiaomi_mac_is_valid(hw)) {
+			continue;
+		}
+		strlcpy(mac, hw, 18);
+		found = true;
+		break;
+	}
+	pclose(p);
+	if (found) {
+		xiaomi_mac_lower(mac);
+	}
+	return found;
+}
+
+static bool xiaomi_mac_from_arp(const char *ip, char mac[18])
+{
+	const char *path = xiaomi_env("XIAOMI_ARP_FILE",
+				      XIAOMI_DEFAULT_ARP_FILE);
+	char line[256];
+	char tip[64];
+	char hw[32];
+	unsigned int hwtype = 0;
+	unsigned int flags = 0;
+	FILE *f;
+	bool found = false;
+
+	f = fopen(path, "r");
+	if (f == NULL) {
+		return false;
+	}
+	while (fgets(line, sizeof(line), f) != NULL) {
+		if (sscanf(line, "%63s 0x%8x 0x%8x %31s",
+			   tip, &hwtype, &flags, hw) != 4) {
+			continue;
+		}
+		if (!strequal(tip, ip) || !xiaomi_mac_is_valid(hw)) {
+			continue;
+		}
+		strlcpy(mac, hw, 18);
+		found = true;
+		break;
+	}
+	fclose(f);
+	if (found) {
+		xiaomi_mac_lower(mac);
+	}
+	return found;
+}
+
+static void xiaomi_run_arping(const char *ip)
+{
+	char cmd[256];
+	const char *iface = xiaomi_env("XIAOMI_ARP_INTERFACE",
+				       XIAOMI_DEFAULT_ARP_INTERFACE);
+
+	if (xiaomi_helper_disabled(iface)) {
+		return;
+	}
+	snprintf(cmd, sizeof(cmd), "arping -f -c 2 -w 1 -I %s %s", iface, ip);
+	if (system(cmd) != 0) {
+		DBG_INFO("xiaomi-mac-policy: arping %s failed\n", ip);
+	}
+}
+
+static bool xiaomi_cache_lookup(const char *ip, char mac[18])
+{
+	int ttl = xiaomi_cache_ttl();
+	time_t now;
+	size_t i;
+
+	if (ttl == 0) {
+		return false;
+	}
+	now = time(NULL);
+	pthread_mutex_lock(&xiaomi_mac_cache_mutex);
+	for (i = 0; i < XIAOMI_MAC_CACHE_SIZE; i++) {
+		if (xiaomi_mac_cache[i].ip[0] == '\0') {
+			continue;
+		}
+		if (!strequal(xiaomi_mac_cache[i].ip, ip)) {
+			continue;
+		}
+		if ((now - xiaomi_mac_cache[i].timestamp) > ttl) {
+			xiaomi_mac_cache[i].ip[0] = '\0';
+			break;
+		}
+		strlcpy(mac, xiaomi_mac_cache[i].mac, 18);
+		pthread_mutex_unlock(&xiaomi_mac_cache_mutex);
+		return true;
+	}
+	pthread_mutex_unlock(&xiaomi_mac_cache_mutex);
+	return false;
+}
+
+static void xiaomi_cache_store(const char *ip, const char *mac)
+{
+	int ttl = xiaomi_cache_ttl();
+	size_t i;
+	size_t slot = 0;
+	time_t oldest = 0;
+
+	if (ttl == 0) {
+		return;
+	}
+	pthread_mutex_lock(&xiaomi_mac_cache_mutex);
+	for (i = 0; i < XIAOMI_MAC_CACHE_SIZE; i++) {
+		if (strequal(xiaomi_mac_cache[i].ip, ip)) {
+			slot = i;
+			goto store;
+		}
+		if (xiaomi_mac_cache[i].ip[0] == '\0') {
+			slot = i;
+			goto store;
+		}
+		if (oldest == 0 || xiaomi_mac_cache[i].timestamp < oldest) {
+			oldest = xiaomi_mac_cache[i].timestamp;
+			slot = i;
+		}
+	}
+store:
+	strlcpy(xiaomi_mac_cache[slot].ip, ip,
+		sizeof(xiaomi_mac_cache[slot].ip));
+	strlcpy(xiaomi_mac_cache[slot].mac, mac,
+		sizeof(xiaomi_mac_cache[slot].mac));
+	xiaomi_mac_cache[slot].timestamp = time(NULL);
+	pthread_mutex_unlock(&xiaomi_mac_cache_mutex);
+}
+
+/*
+ * Resolve the MAC for an IPv4 address.  Returns false when the MAC is
+ * unknown; callers must treat that as "not listed".
+ */
+static bool xiaomi_resolve_mac(const char *ip, char mac[18])
+{
+	mac[0] = '\0';
+	if (xiaomi_cache_lookup(ip, mac)) {
+		return true;
+	}
+
+	if (xiaomi_mac_from_trafficd(ip, mac) ||
+	    xiaomi_mac_from_arp(ip, mac)) {
+		xiaomi_cache_store(ip, mac);
+		return true;
+	}
+
+	xiaomi_run_arping(ip);
+	if (xiaomi_mac_from_arp(ip, mac) ||
+	    xiaomi_mac_from_trafficd(ip, mac)) {
+		xiaomi_cache_store(ip, mac);
+		return true;
+	}
+	return false;
+}
+
+static bool xiaomi_mac_in_file(const char *path, const char *mac)
+{
+	char line[256];
+	FILE *f;
+	bool found = false;
+
+	f = fopen(path, "r");
+	if (f == NULL) {
+		return false;
+	}
+	while (fgets(line, sizeof(line), f) != NULL) {
+		char *p = line;
+		size_t len;
+
+		while (*p == ' ' || *p == '\t') {
+			p++;
+		}
+		len = strlen(p);
+		while (len > 0 &&
+		       (p[len - 1] == '\n' || p[len - 1] == '\r' ||
+			p[len - 1] == ' ' || p[len - 1] == '\t')) {
+			p[--len] = '\0';
+		}
+		if (strcmp(p, mac) == 0) {
+			found = true;
+			break;
+		}
+	}
+	fclose(f);
+	return found;
+}
+
+static bool xiaomi_mac_decision(const char *remote, int snum, bool allow_ipc)
+{
+	const char *sharename;
+	const char *login_file;
+	const char *nonlogin_file;
+	char ip[INET_ADDRSTRLEN];
+	char mac[18];
+	bool have_ip;
+	bool listed = false;
+	bool browseable;
+	bool allowed;
+	const char *result;
+
+	if (snum < 0) {
+		return true;
+	}
+
+	sharename = lp_const_servicename(snum);
+	if (allow_ipc && sharename != NULL && strequal(sharename, "IPC$")) {
+		return true;
+	}
+
+	browseable = lp_browseable(snum);
+
+	have_ip = xiaomi_ipv4_string(remote, ip);
+	if (have_ip && xiaomi_resolve_mac(ip, mac)) {
+		login_file = xiaomi_env("XIAOMI_LOGIN_MAC_FILE",
+					XIAOMI_DEFAULT_LOGIN_MAC_FILE);
+		nonlogin_file = xiaomi_env("XIAOMI_NONLOGIN_MAC_FILE",
+					   XIAOMI_DEFAULT_NONLOGIN_MAC_FILE);
+		listed = xiaomi_mac_in_file(login_file, mac) ||
+			 xiaomi_mac_in_file(nonlogin_file, mac);
+	} else {
+		mac[0] = '\0';
+	}
+
+	allowed = listed ? !browseable : browseable;
+	result = allowed ? "Allowed" : "Denied";
+
+	DBG_NOTICE("xiaomi-mac-policy: %s connection from %s to [%s] "
+		   "(snum %d, mac %s, browseable %s, listed %s)\n",
+		   result,
+		   have_ip ? ip : "(no-ipv4)",
+		   sharename != NULL ? sharename : "(none)",
+		   snum,
+		   mac[0] != '\0' ? mac : "(unresolved)",
+		   browseable ? "yes" : "no",
+		   listed ? "yes" : "no");
+
+	return allowed;
+}
+
+bool xiaomi_mac_share_allowed(const struct tsocket_address *remote, int snum)
+{
+	char *remote_str;
+	bool allowed;
+
+	if (!xiaomi_mac_filter_enabled()) {
+		return true;
+	}
+	if (snum < 0) {
+		return true;
+	}
+	if (remote == NULL) {
+		return xiaomi_mac_decision(NULL, snum, true);
+	}
+	remote_str = tsocket_address_inet_addr_string(remote, talloc_tos());
+	if (remote_str == NULL) {
+		return xiaomi_mac_decision(NULL, snum, true);
+	}
+	allowed = xiaomi_mac_decision(remote_str, snum, true);
+	TALLOC_FREE(remote_str);
+	return allowed;
+}
+
+bool xiaomi_mac_share_visible(const struct tsocket_address *remote, int snum)
+{
+	char *remote_str;
+	bool visible;
+
+	if (!xiaomi_mac_filter_enabled()) {
+		return lp_browseable(snum);
+	}
+	if (snum < 0) {
+		return false;
+	}
+	if (remote == NULL) {
+		return xiaomi_mac_decision(NULL, snum, false);
+	}
+	remote_str = tsocket_address_inet_addr_string(remote, talloc_tos());
+	if (remote_str == NULL) {
+		return xiaomi_mac_decision(NULL, snum, false);
+	}
+	visible = xiaomi_mac_decision(remote_str, snum, false);
+	TALLOC_FREE(remote_str);
+	return visible;
+}
--- /dev/null
+++ b/source3/smbd/xiaomi_mac_policy.h
@@ -0,0 +1,36 @@
+/*
+   Xiaomi MAC based share policy, Samba 4.25.x port.
+
+   Behaviour mirrors the vendor hook in the 4.0.21 samba_multicall binary:
+   a client whose MAC is present in either MAC list may only use
+   non-browseable shares, every other client may only use browseable
+   shares.  IPC$ and connection level (snum < 0) lookups are always
+   allowed and are handled by the caller.
+
+   This program is free software; you can redistribute it and/or modify
+   it under the terms of the GNU General Public License as published by
+   the Free Software Foundation; either version 3 of the License, or
+   (at your option) any later version.
+*/
+
+#ifndef __XIAOMI_MAC_POLICY_H__
+#define __XIAOMI_MAC_POLICY_H__
+
+struct tsocket_address;
+
+/*
+ * Connection / tree connect decision.  Returns true when the client is
+ * allowed to connect to snum.
+ */
+bool xiaomi_mac_share_allowed(const struct tsocket_address *remote, int snum);
+
+/*
+ * Enumeration decision.  Same rule as above but without the IPC$
+ * special case, because IPC$ visibility has to follow browseable.
+ */
+bool xiaomi_mac_share_visible(const struct tsocket_address *remote, int snum);
+
+/* True when the filter is enabled (XIAOMI_MAC_FILTER, default enabled). */
+bool xiaomi_mac_filter_enabled(void);
+
+#endif /* __XIAOMI_MAC_POLICY_H__ */
