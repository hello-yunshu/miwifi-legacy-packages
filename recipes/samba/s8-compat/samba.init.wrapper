#!/bin/sh /etc/rc.common
# S8 SMB compatibility init: version switch for the vendor SMB service entry.
#
# Layout (all on the internal HDD, see /userdisk/data/.yunshu/live/s8compat):
#   versions/v1/hook.sh            -> drives the new Samba instance
#   versions/v0-vendor/            -> empty marker: full vendor behaviour
#   current -> versions/v1         -> active compatibility version
#   /etc/init.d/samba.vendor       -> byte-identical copy of the vendor init
#
# The vendor implementation is sourced below, then only the four entry points
# that own the SMB process are overridden.  If the versioned hook is absent
# (explicit rollback, or a boot without /userdisk/data), the vendor script is
# executed unchanged, so the factory capability is never lost.

if [ ! -r /etc/init.d/samba.vendor ]; then
	echo "s8compat: /etc/init.d/samba.vendor missing" >&2
	exit 1
fi

. /etc/init.d/samba.vendor

S8COMPAT_HOOK=/userdisk/data/.yunshu/live/s8compat/current/hook.sh

# rc.common shifts its own argv before sourcing this file, so the action is in
# $action, not in $@.  Pass it explicitly or the vendor script sees no command.
if [ ! -x "$S8COMPAT_HOOK" ]; then
	exec /etc/init.d/samba.vendor "${action:-help}"
fi

s8compat() {
	"$S8COMPAT_HOOK" "$@"
}

start_impl() {
	/usr/sbin/shareUpdate -s
	updateconfig

	s8compat start
	rc=$?
	if [ $rc -ne 0 ]; then
		logger -t s8compat "new smbd start failed rc=$rc"
		return 1
	fi

	service_start /usr/sbin/nmbd -D

	smbid=$(pidof samba-s5d)
	[ -z "$smbid" ] && {
		sleep 3
		smbid=$(pidof samba-s5d)
	}
	nmbid=$(pidof nmbd)

	if [ -n "$smbid" -a -n "$nmbid" ]; then
		if [ -f /dev/cgroup/cpu/samba/tasks ]; then
			echo $smbid >/dev/cgroup/cpu/samba/tasks
			echo $nmbid >/dev/cgroup/cpu/samba/tasks
		fi
		return 0
	fi
	return 1
}

stop() {
	rc=0
	s8compat stop || rc=$?
	service_stop /usr/sbin/nmbd
	# A foreign listener (e.g. the vendor smbd started while the hook was
	# hidden) is not ours to kill: report it instead of a silent success.
	return $rc
}

reload() {
	updateconfig
	smbcontrol all reload-config >/dev/null 2>&1
	s8compat reload
	return $?
}

status() {
	s8compat status
	ret=$?
	echo $ret
	return $ret
}
