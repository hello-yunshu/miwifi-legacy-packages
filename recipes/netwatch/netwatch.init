#!/bin/sh /etc/rc.common
# netwatch 开机拉起钩子（非阻塞：等待 /userdisk/data 挂载在子进程里做）
START=98
STOP=10
USE_PROCD=0

start() {
	NB=/userdisk/data/.dev/live/netwatch/run.sh
	( i=0; while [ ! -x "$NB" ] && [ "$i" -lt 180 ]; do sleep 1; i=$((i+1)); done
	  [ -x "$NB" ] && "$NB" start ) >/dev/null 2>&1 &
}

stop() {
	NB=/userdisk/data/.dev/live/netwatch/run.sh
	[ -x "$NB" ] && "$NB" stop >/dev/null 2>&1
}
